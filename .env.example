# Postgres connection string. On Railway, add a reference to the Postgres
# service's DATABASE_URL instead of pasting a value.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# The port the server listens on. Railway injects this; if you set a custom
# target port on the domain, set PORT to the same number. Defaults to 8080.
PORT=8080

# Shared secret the scheduler must present to POST /api/cron
CRON_SECRET=change-me

# Signs the login cookie; any long random string. Falls back to CRON_SECRET.
AUTH_SECRET=

# Email put on the first (Maria) account, so "forgot password" can reach her.
# Can also be set later on the Setup page.
ADMIN_EMAIL=

# Email via Resend (leave unset to skip email)
RESEND_API_KEY=
MAIL_FROM="Chair & Comb <hello@example.com>"
MAIL_REPLY_TO=

# SMS via Twilio (leave unset to skip texts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Log every message as sent without contacting a provider
DRY_RUN=false

# Photo storage: set an R2/S3 bucket, or fall back to a disk path
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
UPLOAD_DIR=/data/uploads
