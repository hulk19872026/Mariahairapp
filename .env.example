# Postgres connection string (Railway provides this on the Postgres service)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret the scheduler must present to POST /api/cron
CRON_SECRET=change-me

# Email via Resend (leave unset to skip email)
RESEND_API_KEY=
MAIL_FROM="Chair & Comb <hello@example.com>"
MAIL_REPLY_TO=

# SMS via Twilio (leave unset to skip texts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Log every message as sent without contacting a provider
DRY_RUN=false

# Photo storage: set an R2/S3 bucket, or fall back to a disk path
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
UPLOAD_DIR=/data/uploads
